---
import { site } from "../data/config";
import Icon from "./Icon.astro";
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-inner">
      <img
        class="hero-logo"
        src="/logo-el-hangar.png"
        alt="El Hangar - Distribuimos Calidad"
        width="1121"
        height="610"
      />

      <h1 id="hero-title">
        Frutos secos, especias y granos. <span>Por kilo y por bulto.</span>
      </h1>

      <p class="hero-lead">
        Venta directa de productos seleccionados de máxima calidad en Mar del Plata y zona.
      </p>

      <ul class="hero-facts" aria-label="Datos de El Hangar">
        <li>
          <Icon name="check" size={16} />
          <span>100% puro y natural</span>
        </li>
        <li>
          <Icon name="scale" size={16} />
          <span>Venta por kilo y bulto</span>
        </li>
        <li>
          <Icon name="layers" size={16} />
          <span> + de 300 productos</span>
        </li>
      </ul>

      <div class="hero-actions">
        <a
          class="btn btn--solid"
          href={site.catalogo.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver catálogo y precios, se abre en una pestaña nueva"
        >
          Ver catálogo y precios
          <Icon name="arrow" size={18} />
        </a>
        <a
          class="btn btn--outline"
          href={site.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Consultar por WhatsApp, se abre en una pestaña nueva"
        >
          <Icon name="whatsapp" size={18} />
          Consultar por WhatsApp
        </a>
      </div>

      <p class="hero-meta">
        <span>Distribuidora · {site.contacto.zona}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    background:
      radial-gradient(circle at 50% -10%, rgba(52, 211, 153, 0.16), transparent 42%),
      linear-gradient(180deg, var(--verde) 0%, var(--verde-hondo) 100%);
    color: var(--blanco);
  }

  .hero-inner {
    display: flex;
    max-width: 880px;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(30px, 5vw, 58px) clamp(48px, 7vw, 82px);
    margin-inline: auto;
    text-align: center;
  }

  .hero-logo {
    width: clamp(180px, 23vw, 224px);
    height: auto;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.16));
  }

  .hero-kicker {
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.56);
    font-family: var(--fuente-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 24ch;
    margin-top: clamp(18px, 3vw, 28px);
    color: var(--blanco);
    font-size: clamp(2.25rem, 4.7vw, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  h1 span {
    color: var(--menta-clara);
  }

  .hero-lead {
    max-width: 54ch;
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.6;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    padding: 0;
    margin-top: clamp(22px, 3vw, 30px);
    list-style: none;
  }

  .hero-facts li {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    gap: 7px;
    padding: 0.46rem 0.78rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.075);
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.73rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .hero-facts :global(svg) {
    flex: 0 0 auto;
    color: var(--menta-clara);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(24px, 3.4vw, 32px);
  }

  .hero-actions .btn {
    min-width: 210px;
  }

  .hero-actions .btn--outline {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
    color: var(--blanco);
  }

  .hero-actions .btn--outline:hover {
    border-color: rgba(255, 255, 255, 0.52);
    background: rgba(255, 255, 255, 0.12);
    color: var(--blanco);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 18px;
    margin-top: clamp(22px, 3vw, 30px);
    color: rgba(255, 255, 255, 0.48);
    font-family: var(--fuente-mono);
    font-size: 0.58rem;
    line-height: 1.5;
    letter-spacing: 0.025em;
  }

  @media (max-width: 480px) {
    .hero-inner {
      padding-block: 28px 56px;
    }

    .hero-logo {
      width: 176px;
    }

    h1 {
      margin-top: 20px;
      font-size: clamp(2.1rem, 9.2vw, 2.55rem);
    }

    .hero-facts {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .hero-facts li {
      justify-content: center;
      border-radius: 12px;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
      min-width: 0;
    }
  }
</style>

---
import { site } from "../data/config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "El Hangar | Frutos secos y especias por kilo y bulto en Mar del Plata",
  description = "El Hangar distribuye frutos secos, especias, legumbres, harinas, repostería y aceitunas por kilo y bulto en Mar del Plata y zona. Consultá el catálogo y pedí por WhatsApp.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B4A2E" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.marca} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" href="/public/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --verde: #0b4a2e;
    --verde-hondo: #06301e;
    --verde-medio: #0c3a23;
    --menta: #34d399;
    --menta-clara: #6ee7b7;
    --menta-suave: #def7ea;
    --menta-borde: #a8e8c9;
    --menta-texto: #065f46;
    --violeta: #7c3aed;
    --violeta-suave: #eee9fe;
    --fondo: #eef2f8;
    --fondo-alt: #e7edf5;
    --seccion-base: #ffffff;
    --seccion-alterna: #ebf0f7;
    --superficie: #ffffff;
    --superficie-2: #f5f8fc;
    --tarjeta: #e9eef6;
    --borde: #d5dde8;
    --borde-suave: #e4eaf2;
    --texto: #10241a;
    --texto-suave: #5b6b7a;
    --foco: #0b4a2e;
    --blanco: #ffffff;
    --fuente-cuerpo: "Plus Jakarta Sans", "Segoe UI", sans-serif;
    --fuente-titulo: "Plus Jakarta Sans", "Segoe UI", sans-serif;
    --fuente-mono: "JetBrains Mono", "Courier New", monospace;
    --ancho: 1100px;
    --margen: 20px;
    --radio-sm: 10px;
    --radio-md: 16px;
    --radio-lg: 22px;
    --radio-xl: 28px;
    --sombra-suave: 0 18px 46px rgba(6, 48, 30, 0.08), 0 2px 8px rgba(16, 36, 26, 0.04);
    --sombra-tarjeta: 0 10px 28px rgba(6, 48, 30, 0.06);
  }

  @media (min-width: 720px) {
    :root {
      --margen: 28px;
    }
  }

  @media (min-width: 1024px) {
    :root {
      --margen: 32px;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
  }

  html {
    background: var(--fondo);
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    background: var(--fondo);
    color: var(--texto);
    font-family: var(--fuente-cuerpo);
    font-size: 1rem;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  button,
  input,
  select {
    color: inherit;
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  ::selection {
    background: var(--menta);
    color: var(--verde-hondo);
  }

  :focus-visible {
    outline: 3px solid var(--foco);
    outline-offset: 3px;
  }

  .wrap {
    width: min(calc(100% - (var(--margen) * 2)), var(--ancho));
    margin-inline: auto;
  }

  .skip-link {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 200;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    background: var(--menta);
    color: var(--verde-hondo);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--fuente-titulo);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  .section-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 18px;
    border-radius: var(--radio-md);
    background: linear-gradient(120deg, var(--verde) 0%, var(--verde-medio) 100%);
    box-shadow: 0 10px 24px rgba(6, 48, 30, 0.12);
    color: var(--blanco);
  }

  .section-banner__main {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
  }

  .section-banner__icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--menta-clara);
  }

  .section-banner__copy {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 10px;
  }

  .section-banner__index {
    color: var(--menta-clara);
    font-family: var(--fuente-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .section-banner h2 {
    color: var(--blanco);
    font-size: clamp(0.84rem, 1.5vw, 0.98rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.075em;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .section-banner__pill {
    display: inline-flex;
    max-width: 42%;
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    padding: 0.38rem 0.68rem;
    border-radius: 999px;
    background: var(--blanco);
    color: var(--verde);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-title {
    max-width: 18ch;
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.06;
  }

  .section-title span {
    color: var(--menta-texto);
  }

  .btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.84rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: var(--fuente-cuerpo);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease,
      transform 140ms ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--solid {
    border-color: var(--menta);
    background: var(--menta);
    color: var(--verde-hondo);
  }

  .btn--solid:hover {
    border-color: var(--menta-clara);
    background: var(--menta-clara);
  }

  .btn--outline {
    border-color: var(--borde);
    background: var(--superficie);
    color: var(--menta-texto);
  }

  .btn--outline:hover {
    border-color: var(--menta-borde);
    background: var(--menta-suave);
    color: var(--menta-texto);
  }

  .btn--sm {
    min-height: 40px;
    padding: 0.62rem 0.85rem;
    font-size: 0.76rem;
  }

  .mono {
    font-family: var(--fuente-mono);
    font-variant-numeric: tabular-nums;
  }

  [id] {
    scroll-margin-top: 24px;
  }

  @media (max-width: 560px) {
    .section-banner {
      gap: 8px;
      padding: 12px 14px;
    }

    .section-banner__icon {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
      border-radius: 10px;
    }

    .section-banner__copy {
      display: block;
    }

    .section-banner__index {
      display: block;
      margin-bottom: 2px;
      font-size: 0.58rem;
    }

    .section-banner h2 {
      font-size: 0.78rem;
      letter-spacing: 0.055em;
    }

    .section-banner__pill {
      padding: 0.34rem 0.58rem;
      font-size: 0.61rem;
    }

    .section-title {
      font-size: clamp(1.85rem, 9vw, 2.4rem);
    }

    .btn {
      min-height: 50px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import QuienesSomos from "../components/QuienesSomos.astro";
import QueVendemos from "../components/QueVendemos.astro";
import ComoComprar from "../components/ComoComprar.astro";
import PasosPedido from "../components/PasosPedido.astro";
import Cierre from "../components/Cierre.astro";
import BotonWhatsApp from "../components/BotonWhatsApp.astro";
---

<Layout>
  <Header />
  <main id="contenido">
    <Hero />
    <QuienesSomos />
    <QueVendemos />
    <ComoComprar />
    <PasosPedido />
    <Cierre />
  </main>
  <BotonWhatsApp />
</Layout>
